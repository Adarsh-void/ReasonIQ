# GEMINI_API_KEY: Default fallback key for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Individual users also configure and store their own encrypted key at registration.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# APP_ENCRYPTION_SECRET: 32+ character secret used for AES-256-GCM encryption of stored API keys.
# If omitted, the server automatically generates and stores a secure key in .secrets/encryption.key.
APP_ENCRYPTION_SECRET="replace_with_32_character_random_hex_or_passphrase"

# TRANSACTIONAL EMAIL CONFIGURATION (SMTP)
# Configure these variables to dispatch real 6-digit OTP codes for account registration and password resets.
# Supported providers: Resend (smtp.resend.com), Brevo, SendGrid, Amazon SES, Postmark, or Gmail SMTP.
# If these variables are not provided, the server runs in development mode and provides verification codes directly in responses.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="smtp_username_or_api_key"
SMTP_PASS="smtp_password_or_secret"
SMTP_FROM='"Synapse Analytics" <noreply@reasoniq.app>'
